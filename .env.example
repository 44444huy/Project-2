# Copy this file to .env and replace every placeholder before starting Compose.
# DATA_MODE=million reads exactly 1,000,000 reviews from the first source parts
# plus the complete product metadata source.
# DATA_MODE=full reads every part prepared by scripts/download_full_dataset.py.
DATA_MODE=million
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DEFAULT_PARALLELISM=8
CODE_VERSION=local-working-tree

AIRFLOW_DB=airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-airflow-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-strong-airflow-webserver-secret
AIRFLOW_TASK_RETRIES=1
AIRFLOW_RETRY_DELAY_SECONDS=60
POSTGRES_DB=review_lakehouse
POSTGRES_USER=review_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

POLARIS_DB_USER=polaris_user
POLARIS_DB_PASSWORD=replace-with-a-strong-polaris-database-password
POLARIS_BASE_URL=http://polaris:8181
POLARIS_REALM=POLARIS
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=replace-with-a-strong-polaris-client-secret
POLARIS_CATALOG_NAME=review_catalog
POLARIS_CATALOG_ROLE=catalog_admin
POLARIS_WAREHOUSE=s3://lakehouse/warehouse
POLARIS_S3_ENDPOINT=http://minio:9000
POLARIS_S3_REGION=ap-southeast-1

MINIO_ROOT_USER=replace-with-a-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
